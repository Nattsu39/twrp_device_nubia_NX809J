# ---------------------------------------------------------------------------
# NX809J (RedMagic 11 Pro / canoe / SM8850) 适配版
# 已移除参考树(thales)里的 Xiaomi 专有服务:
#   odm.variant-script / odm.vibratorfeature-service / odm.touch_report /
#   odm.weaver-service / odm.prepdecrypt
# 换成 NX809J 真实存在的服务(名称取自真机 /vendor/etc/init/*.rc)
# ---------------------------------------------------------------------------

import /init.recovery.wifi.rc

on init
    start vendor.boot-qti

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    # Its SSD listener opens by-name/ssd, which ueventd may not have made yet.
    wait /dev/block/bootdevice/by-name/ssd 10
    start vendor.qseecomd
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    mkdir /tmp/persist 0775 shell system
    mount none /tmp/persist /mnt/vendor/persist bind rec
    install_keyring

on boot
    setprop sys.usb.config adb
    start nx809j-touch

# vendor_boot supplies modules matching the running kernel. The Synaptics
# platform device may remain unbound after its SPI transport appears.
service nx809j-touch /system/bin/sh /system/bin/init.nx809j-touch.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# qseecomd is up, so the HALs that reach a trustlet through it can follow.
# 服务名取自真机:
#   vendor.gatekeeper_default          <- android.hardware.gatekeeper-service-qti.rc
#   gto_secure_element_aidl_service    <- android.hardware.secure_element.rc
on property:vendor.sys.listeners.registered=true
    start vendor.gatekeeper_default
    start gto_secure_element_aidl_service

on property:twrp.modules.loaded=true
    # 振动: NX809J 用 Qualcomm + AWINIC(aw86320) 方案, 服务名 vendor.qti.vibrator
    # (参考树是 Xiaomi 的 odm.vibratorfeature-service, 本机不存在)
    start vendor.qti.vibrator
    # Keep the modem image mounted: qca_cld3_peach_v2 loads WLAN firmware
    # from /vendor/firmware_mnt/image after the driver is inserted.
    mkdir /vendor/firmware_mnt 0755 root shell
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /vendor/firmware_mnt ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337
    mount none /vendor/firmware_mnt /firmware bind
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    # This make USB-OTG work
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1
    wait /sys/class/power_supply/battery
    start vendor.health-default
    setprop twrp.firmware.mounted true
