# Recovery identity and crypto configuration for the installed Avium firmware.
# Do not copy the complete stock build.prop: without vendor property contexts,
# its hundreds of values exhaust the vendor_default_prop shared memory area.
ro.product.vendor.brand=REDMAGIC
ro.product.vendor.device=NX809J
ro.product.vendor.manufacturer=nubia
ro.product.vendor.model=NX809J
ro.product.vendor.name=NX809J
ro.vendor.product.cpu.abilist=arm64-v8a
ro.vendor.product.cpu.abilist64=arm64-v8a
ro.vendor.build.version.release=16
ro.vendor.build.version.sdk=36
ro.vendor.build.security_patch=2026-03-01
ro.board.platform=canoe
ro.board.first_api_level=202504
ro.product.first_api_level=36
vendor.keymint.retry_timer=5
vendor.gatekeeper.is_security_level_spu=0
vendor.gatekeeper.disable_spu=true
